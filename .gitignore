.env
.env.*
credentials.json
client_secret.json
token.json
token_*.json
gcal_token.json
strava_token.json

# Notion / Sheets / API caches
*.pickle
*.pkl

# ──────────────────────────────────────────────────────────────
# PYTHON
# ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# Bytecode compilé dans des sous-dossiers
**/__pycache__/
**/*.pyc

# ──────────────────────────────────────────────────────────────
# BUILD / PACKAGING
# ──────────────────────────────────────────────────────────────
*.egg-info/
*.egg
build/
dist/
pip-wheel-metadata/

